{
  "name": "dsh-cpa",
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "check": "node --check src/index.js && node --check src/core/config.js && node --check src/core/adapter.js && node --check src/core/services.js && node --check src/server/management.js && node --check src/server/quota.js && node --check src/server/runtime.js && node --check src/client.js",
    "test": "node --test test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
