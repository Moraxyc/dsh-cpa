{
  "name": "dsh-cpa",
  "version": "0.1.6",
  "description": "DSH CPA provider and runtime plugin",
  "keywords": [
    "dsh-plugin",
    "cpa"
  ],
  "homepage": "https://github.com/Moraxyc/dsh-cpa",
  "bugs": {
    "url": "https://github.com/Moraxyc/dsh-cpa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moraxyc/dsh-cpa.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "files": [
    "src/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "check": "tsc --noEmit && oxlint",
    "build": "tsc",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.81.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "oxlint": "^1.81.0",
    "typescript": "^7.0.2"
  }
}
