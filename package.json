{
  "name": "dsh-cpa",
  "version": "0.1.13",
  "description": "DSH CPA provider and runtime plugin",
  "keywords": [
    "dsh-plugin",
    "cpa"
  ],
  "homepage": "https://github.com/Moraxyc/dsh-cpa",
  "bugs": {
    "url": "https://github.com/Moraxyc/dsh-cpa/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moraxyc/dsh-cpa.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "scripts": {
    "check": "npm run build && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json && oxlint",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.build.json",
    "build:client": "node scripts/build-client.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test \"tests/**/*.test.ts\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.92.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.92.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "types": "./lib/index.d.ts"
}
